# For a fresh database, choose a new random password before starting Compose.
SHADYBANK_DB_PASSWORD=
# Optional scoped member API credential; leave blank when disabled.
SHADYBANK_MEMBER_SERVICE_KEY=
# Optional merchant authorization key, separate from the member endpoint key.
SHADYBANK_MERCHANT_SERVICE_KEY=
SHADYBANK_MERCHANT_ACCOUNT_ID=
# Enable scoped capture only after the additive migration and client qualification.
SHADYBANK_MERCHANT_CAPTURE_ENABLED=0
SHADYBANK_MERCHANT_TERMINAL_REPORTS_ENABLED=0
# Legacy ShadyBucks magnetic-card input is transient; set 0 to reject it.
SHADYBANK_ALLOW_LEGACY_TRACKS=1
